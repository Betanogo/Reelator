{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": [
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/renderer/*"
      ],
      "@shared/*": [
        "src/renderer/*"
      ],
      "@common/*": [
        "src/shared/*"
      ]
    }
  },
  "include": [
    "src/**/*",
    "mobile/src/**/*",
    "electron.vite.config.ts",
    "mobile/vite.config.ts"
  ]
}
